# 复制为 .env 后按需修改；.env 已在 .gitignore 里
TZ=Asia/Shanghai

# TMDB 兜底 API Key（可选，源码里不内置任何 Key）。
# 留空时到「设置 → 电影数据源」填自己的 Key；无人值守部署可在这里注入。
# 注意：这一项会作为进程环境变量传给容器，不要把生产 Key 写进任何会提交的文件。
STRM115_TMDB_KEY=

# 管理员账号密码不在这里配。启动后打开 http://<本机IP>:6060，
# 第一次访问会让你设置账号和密码，存在 ./data/strm115.db 里。
# 只有「无人值守部署」（比如 CI、云端一键脚本）才需要下面这两个：
#   ADMIN_USER=admin
#   ADMIN_PASSWORD=换成强密码
# 注意：数据库里已经有账号时它们会被忽略，不会覆盖你在网页里改过的密码。

# 宿主端口。被占用时改这里（左边宿主、右边容器，右边不要动）。
ADMIN_PORT=6060
PLAY_PORT=6086
# Emby Web 界面（只有用 --profile emby 启动 Emby 时才生效）
EMBY_PORT=8096

# 宿主媒体目录。填绝对路径：既是容器 /media 的挂载源，也用于详情抽屉里
# 「本地目录」的宿主机路径换算（相对值 ./media 在容器内换算不出来，只会显示 /media/...）。
#   Linux/NAS: /volume1/media
#   Windows:   D:/media/strm115
MEDIA_HOST_PATH=./media

# 运行身份。在宿主执行 id -u / id -g 得到。
# Windows Docker Desktop 的 bind mount 不看 uid，保持 1000 即可。
PUID=1000
PGID=1000

# 镜像标签，同时作为 main.Version 注入
VERSION=v0.7.2

# ============================================================
# 以下变量只给「一次性引导」用（profiles: auto 里的 bootstrap 服务）
# 命令：docker compose --profile auto run --rm bootstrap
# 正常用网页点一遍就够了，这段是给无人值守/重建环境准备的。
# 它的活是：走完 Emby 向导 → 建 API Key → 接入 strm115 → 加 115 账号
#           → 建媒体库 → 全量同步 → 在 Emby 上建库并扫描
# ============================================================

# .strm 里写的播放地址，**必须是播放器能访问到的地址**。
# 常见错误：填 127.0.0.1（只有容器自己能访问）或容器内网 IP（如 172.17.0.2）。
#   Windows 查法：ipconfig → 无线/以太网适配器的 IPv4 地址
#   Linux/NAS 查法：ip addr 或 hostname -I
# 留空（或后台已有值）时引导一律沿用后台保存的地址，不会被这里的旧值覆盖回去
# —— 换路由器后自愈改出来的新 IP 才不会被重启又改坏。确实要用本文件强制覆盖：
# PLAY_DOMAIN_FORCE=1
# 想彻底不依赖局域网 IP，可以填一个指向播放端口的固定域名；换了路由器/网段时
# 程序也会自动跟随（详见 README「换路由器 / 换网段会怎样」）。
PLAY_DOMAIN=http://192.168.1.10:6086

# ---------- Emby ----------
# 容器内的服务名。Emby 跑在别处时改成 http://192.168.1.10:8096
EMBY_URL=http://emby:8096
# 不想让引导碰 Emby（比如 Emby 装在别的机器上、打算手动配）就设成 1
EMBY_SKIP=0

# Emby 管理员账号密码。用途只有一个：首次自动创建 API Key。
# 已经手动建好 API Key 的话，这一项可以留空，改填 EMBY_API_KEY。
EMBY_ADMIN_USER=admin
EMBY_ADMIN_PASSWORD=
# 在 Emby 后台「设置 → 高级 → API 密钥」手动建的 key，填这里可跳过登录
EMBY_API_KEY=
# API Key 的备注名，用来做幂等匹配（重复执行不会建一堆 key）
EMBY_APP_NAME=strm115

# 等待 Emby / 同步完成的秒数。超时不算失败，失败会写在引导日志里。
BOOTSTRAP_WAIT_EMBY=90
BOOTSTRAP_WAIT_SYNC=180

# ---------- 115 账号 ----------
# 填了就在首次启动时自动加账号，不用扫码。
# 获取方式：浏览器登录 115 → F12 → Application/存储 → Cookies → 115.com
#   复制 UID / CID / SEID / KID 四项，拼成一行：
#   UID=12345678_A1_1699999999; CID=abcdef...; SEID=...; KID=...
# 注意 Cookie 有有效期，过期后需要重新复制（引导会明确报错）。
PAN115_COOKIE=
# 要映射的网盘目录。两种写法都行：
#   PAN115_CID=电影                     ← 直接写文件夹名（只查根目录，最好用这个）
#   PAN115_CID=3555355939475293750      ← 或者填 cid
# 留空的话引导会把网盘根目录下的文件夹和 cid 打印出来给你挑。
PAN115_CID=
PAN115_ACCOUNT_NAME=115

# ---------- 媒体库 ----------
LIBRARY_NAME=115
# movies / tvshows / mixed
LIBRARY_TYPE=movies
# 1 = .strm 文件名保留原扩展名（推荐，播放器靠它判断能否直放）
LIBRARY_KEEP_EXT=1
