# ============================================================
# 生产环境配置模板（域名 + HTTPS 反代形态）
#
# 用法：
#   cp .env.production.example .env.production
#   # 按实际改域名、邮箱、路径，并逐项核对文件末尾的「上线前检查清单」
#   docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml --profile emby up -d --build
#
# 本文件只有键名和占位值，不含任何真实密钥。
# .env.production 请自行加入 .gitignore，不要提交到仓库。
# ============================================================

# ---------- 域名与证书 ----------
# 三个域名都要能解析到本机，且 80/443 从公网可达（ACME HTTP-01 / TLS-ALPN 校验）。
# Caddyfile 用 {$VAR} 直接引用、不设默认值，漏配会让 Caddy 启动即报错。
ADMIN_DOMAIN=admin.example.com
PLAY_DOMAIN=https://play.example.com
EMBY_DOMAIN=emby.example.com
# 仅用于 Let's Encrypt 账户 / 证书到期通知；留空仍可签发，但收不到告警邮件。
ACME_EMAIL=ops@example.com
# PLAY_DOMAIN 必须写 https，且域名必须与 Caddyfile 的播放站点一致：
# 它是写进 .strm 的播放地址，由播放器 / Emby 直接访问，经 Caddy 走 443。
# 不要带 6086 端口，也不要写成 http 或 127.0.0.1。

# ---------- 端口 ----------
# 只在宿主回环 127.0.0.1 监听；公网入口一律走 caddy 的 80/443。
ADMIN_PORT=6060
PLAY_PORT=6086
EMBY_PORT=8096

# ---------- 路径与权限 ----------
# 必须是宿主绝对路径：既是 /media 的挂载源，也用于后台把容器路径换算成宿主路径。
# 相对值 ./media 在容器内换算不出宿主路径，只会显示 /media/...
MEDIA_HOST_PATH=/srv/strm115/media
# Linux/NAS 上用 `id -u` / `id -g` 对齐宿主目录属主，否则写 .strm 会 Permission denied。
# Windows Docker Desktop 的 bind mount 不看 uid，保持 1000 即可。
PUID=1000
PGID=1000
TZ=Asia/Shanghai
# 镜像标签，同时作为 main.Version 注入
VERSION=v0.1.0

# ---------- 管理员 ----------
# 生产建议留空，走网页首次访问设置（存 ./data/strm115.db，不落配置文件）。
# 若必须预置，不要用明文环境变量：改用 Docker secrets 并自行调整 compose 的 environment，
# 不要写进 .env（进程环境变量对同主机用户/诊断工具可见）。
# ADMIN_USER=admin
# ADMIN_PASSWORD=换成强密码

# ---------- TMDB 兜底 Key（可选） ----------
# 源码不内置任何 Key。生产建议在网页「设置 → 电影数据源」里填（存 SQLite，
# 不落配置文件）；无人值守部署才用环境变量注入，值请放在不入库的 .env.production。
# STRM115_TMDB_KEY=

# ---------- 以下不是环境变量，运行期在网页里配置 ----------
# 它们存进 SQLite 的 settings / accounts 表，写进 .env 也不会被读取：
#   TMDB API Key
#   115 Cookie（UID / CID / SEID / KID）
#   Emby API Key
#   TG Bot Token
#   通知渠道（各类 webhook / 推送配置）
# .env.example 里 bootstrap(--profile auto) 段的 PAN115_COOKIE / EMBY_API_KEY 等
# 只用于无人值守初始化，会把密钥暴露在进程环境里，生产不建议启用该 profile。

# ---------- 上线前检查清单 ----------
# [ ] 管理员已设强口令（优先走网页首次设置），无默认口令、无弱口令
# [ ] 三个域名的 A/AAAA 记录已解析到本机，80/443 从公网可达
# [ ] 防火墙 / 安全组只放行 80/443；6060 / 6086 / 8096 仅 127.0.0.1 可见
# [ ] MEDIA_HOST_PATH 为绝对路径，且目录属主与 PUID/PGID 一致
# [ ] /data 在本地盘（不能 NFS/SMB），已用 scripts/backup.sh 验证备份可恢复
# [ ] 首次启动后确认 Caddy 拿到受信任证书，而不是自签证书
# [ ] .env.production 已加入 .gitignore，仓库里没有任何密钥
